  "scoringEngine": {
    "description": "How raw signals become expertise scores. Not ML — transparent weighted formulas that the AI agent interprets contextually.",
    "formula": {
      "expertiseScore": {
        "components": [
          { "signal": "codeOwnership", "weight": 0.25, "source": "github", "description": "% of code in domain authored/maintained by this person" },
          { "signal": "reviewAuthority", "weight": 0.15, "source": "github", "description": "How often they review (and are requested to review) code in this domain" },
          { "signal": "incidentLeadership", "weight": 0.20, "source": "pagerduty", "description": "Led incident resolution in this domain (high signal — proves real ownership)" },
          { "signal": "ticketDepth", "weight": 0.15, "source": "jira", "description": "Resolved complex tickets (P0-P1) in this domain" },
          { "signal": "documentationAuthority", "weight": 0.10, "source": "confluence", "description": "Authored key docs, ADRs, runbooks for this domain" },
          { "signal": "peerRecognition", "weight": 0.10, "source": "slack", "description": "Organically asked questions by peers in this domain" },
          { "signal": "mentoring", "weight": 0.05, "source": "calendar", "description": "Actively teaching others in this domain" }
        ],
        "scale": "0-100 per domain per person",
        "threshold": {
          "expert": 80,
          "proficient": 60,
          "familiar": 40,
          "novice": 20
        }
      },
      "riskScore": {
        "components": [
          { "factor": "singlePointOfFailure", "weight": 0.30, "description": "Only person with score > 80 in a critical domain" },
          { "factor": "noBackupAboveThreshold", "weight": 0.25, "description": "No second person above 60 in same domain" },
          { "factor": "documentationGap", "weight": 0.15, "description": "Critical knowledge exists only in person's head (no docs, no runbooks)" },
          { "factor": "departureSignals", "weight": 0.15, "description": "Tenure milestones, reduced engagement, market conditions" },
          { "factor": "systemCriticality", "weight": 0.15, "description": "How business-critical are the systems this person owns" }
        ],
        "scale": "0-100 overall risk",
        "threshold": {
          "critical": 75,
          "high": 50,
          "moderate": 25,
          "low": 0
        }
      }
    }
  },
